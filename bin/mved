#!/bin/bash
# VISUAL dispatch script
set -u

if [[ ${TERM:-dumb} = *dumb* ]]; then
    # This may look kinda sketchy, but this is how Bash handles it.
    eval "${EDITOR:-med}" "$@"
    exit
fi

[[ -n ${INSIDE_EMACS:-} ]] && exec emacsclient "$@"

inpath() {
    command -v "$1" >/dev/null 2>&1
}

if inpath emacsclient && emacsclient -a false -e t >/dev/null; then
    exec emacsclient -nw "$@"
fi
# http://emacshorrors.com/posts/come-in-and-find-out.html
inpath emacs && exec emacs -Q -nw --eval "(setq frame-background-mode 'dark)" "$@"

for e in vi nvi vim; do
    inpath $e && exec $e "$@"
done

inpath ed && printf "%s: Using ed as editor\n" "$0" >&2 && exec ed "$@"

printf '%s: No editor available\n' "$0" >&2
exit 1
